# Environment Variables for Gro-Hit Backend
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas for cloud, or local URI)
MONGO_URI=mongodb://localhost:27017/grohit
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/grohit

# JWT Secret (generate a strong random string)
JWT_SECRET=grohit_super_secret_key_change_in_production_2026

# Gemini AI API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
