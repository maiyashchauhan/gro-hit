# =============================================================
# Gro-Hit Rural Support Platform - Environment Configuration
# =============================================================
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit .env files containing real keys to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/grohit
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/grohit

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Google Gemini AI API Key (Backend only - never expose in client-side code)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (For CORS validation)
FRONTEND_URL=http://localhost:3000
